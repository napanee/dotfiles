#!/bin/sh
# Suspend nur, wenn gerade kein Media-Player (MPRIS) etwas abspielt.
# Deckt mpv, Firefox, Chromium, VLC ab. Deckt NICHT ab: stummes Video
# ohne MPRIS-Support (dann suspendet er trotzdem).
status=$(playerctl status 2>/dev/null)
if [ "$status" = "Playing" ]; then
    exit 0   # Video laeuft -> nicht suspenden
fi
exec systemctl suspend
