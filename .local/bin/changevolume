#!/bin/sh

# Increment, decrement, or mute the volume and send a notification
# of the current volume level.

get_icon() {
	if [ "$1" -ge 70 ]; then
		echo "/usr/share/icons/Papirus-Dark/48x48/status/notification-audio-volume-high.svg"
	elif [ "$1" -ge 30 ]; then
		echo "/usr/share/icons/Papirus-Dark/48x48/status/notification-audio-volume-medium.svg"
	else
		echo "/usr/share/icons/Papirus-Dark/48x48/status/notification-audio-volume-low.svg"
	fi
}

send_notification() {
	volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%.0f", $2 * 100}')
	icon=$(get_icon "$volume")
	dunstify -a "changevolume" -u low -r 9993 -h int:value:"$volume" -i "$icon" "Volume: ${volume}%" -t 2000
}

case $1 in
up)
	wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
	wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
	send_notification "$1"
	;;
down)
	wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
	send_notification "$1"
	;;
mute)
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
	if wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED; then
		dunstify -a "changevolume" -t 2000 -r 9993 -u low -i "/usr/share/icons/Papirus-Dark/48x48/status/notification-audio-volume-muted.svg" "Muted"
	else
		send_notification up
	fi
	;;
esac
