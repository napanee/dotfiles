#!/bin/sh

# set cursor-size
xrdb ~/.Xresources

# keymapping
#[[ -f ~/.Xmodmap ]] && xmodmap ~/.Xmodmap

# notification daemon
dunst &

picom &

enpass &

nextcloud &

numlockx &

# --- Screen Lock & Power Management ---
# xidlehook handles fullscreen detection, lock, dpms, and suspend.
xset -dpms
xset s off

xidlehook \
	--not-when-fullscreen \
	--timer 600 'xset dpms 0 0 300; xsecurelock; xset -dpms' '' \
	--timer 900 'systemctl suspend' '' &
