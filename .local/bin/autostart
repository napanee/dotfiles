#!/bin/sh

# set cursor-size
xrdb ~/.Xresources

# keymapping
#[[ -f ~/.Xmodmap ]] && xmodmap ~/.Xmodmap

# notification daemon
dunst &

picom &

enpass &

nextcloud &

numlockx &

# --- Screen Lock & Power Management ---
# 10 min lock → +15 min suspend
xss-lock --transfer-sleep-lock -- xsecurelock &

xset +dpms
xset dpms 900 900 900

xidlehook \
	--not-when-fullscreen \
	--timer 600 'loginctl lock-session' '' \
	--timer 900 'systemctl suspend' '' &
