#!/bin/sh
#
# Zentraler Lock-Wrapper um xsecurelock.
#
# Fix fuer picom als Compositor: Laut xsecurelock-README entfernt picom
# seine Fenster nicht in der benoetigten Reihenfolge. Dadurch kann das
# Sperrfenster auf einzelnen Monitoren nicht greifen (ein Monitor zeigt
# weiter den Desktop) bzw. es erscheint "INCOMPATIBLE COMPOSITOR".
#
# Empfohlener Fix (README):
#   - Composite-Obscurer abschalten: XSECURELOCK_COMPOSITE_OBSCURER=0
#   - Falls weiterhin Compositor-Artefakte: XSECURELOCK_NO_COMPOSITE=1
#     schaltet die Transparenz-Behandlung komplett ab.

# Picom-spezifisch: Obscurer-Fenster nicht zeichnen.
export XSECURELOCK_COMPOSITE_OBSCURER=0

# Transparenz-Behandlung komplett abschalten (robust gegen Compositor-Bugs).
export XSECURELOCK_NO_COMPOSITE=1

exec xsecurelock
