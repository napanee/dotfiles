#!/bin/sh
#
# Zentraler Lock-Wrapper fuer Hyprland/Wayland.
#
# Ersetzt den alten xsecurelock-Wrapper (X11). Unter Wayland uebernimmt
# hyprlock das Sperren; Konfiguration in ~/.config/hypr/hyprlock.conf.
#
# pidof-Check verhindert, dass mehrere hyprlock-Instanzen gestartet werden
# (z.B. wenn loginctl lock-session und ein manueller Aufruf zusammenfallen).

exec hyprlock
