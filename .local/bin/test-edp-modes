#!/usr/bin/env bash
# Testet alle für eDP-1 gelisteten Modi und meldet, welche das Panel akzeptiert.
# Setzt nach jedem Test sofort auf den nativen Mode zurück.
set -uo pipefail

OUTPUT="eDP-1"
NATIVE="2880x1920"
SETTLE=0.6   # Sekunden warten, damit das Modeset sichtbar greift

# Alle Modi aus xrandr für diesen Output ziehen (nur Breite x Höhe, dedupliziert)
mapfile -t MODES < <(
  xrandr | awk -v out="$OUTPUT" '
    $1==out {grab=1; next}
    /^[^ ]/ {grab=0}
    grab && $1 ~ /^[0-9]+x[0-9]+i?$/ {print $1}
  ' | awk '!seen[$0]++'
)

if [ "${#MODES[@]}" -eq 0 ]; then
  echo "Keine Modi für $OUTPUT gefunden." >&2
  exit 1
fi

echo "Teste ${#MODES[@]} Modi auf $OUTPUT (native=$NATIVE)."
echo "Jeder Mode wird kurz gesetzt und sofort zurückgesetzt."
echo

OK=()
FAIL=()

for m in "${MODES[@]}"; do
  printf '  %-12s ... ' "$m"
  if err=$(xrandr --output "$OUTPUT" --mode "$m" 2>&1); then
    echo "OK"
    OK+=("$m")
    sleep "$SETTLE"
  else
    # erste Fehlerzeile kompakt anzeigen
    echo "FAIL (${err%%$'\n'*})"
    FAIL+=("$m")
  fi
  # immer zurück auf nativ, egal ob OK oder FAIL
  xrandr --output "$OUTPUT" --mode "$NATIVE" >/dev/null 2>&1
  sleep "$SETTLE"
done

echo
echo "===================================================="
echo "NUTZBAR (${#OK[@]}):"
for m in "${OK[@]}"; do echo "  xrandr --output $OUTPUT --mode $m"; done
echo
echo "NICHT nutzbar (${#FAIL[@]}):"
for m in "${FAIL[@]}"; do echo "  $m"; done
echo "===================================================="
echo
echo "Zurück auf nativ $NATIVE gesetzt."
