[Desktop Entry]
Version=1.0
Name=Firefox – Robinson
GenericName=Web Browser
Comment=Firefox mit Profil Robinson
Exec=firefox -P Robinson --class firefox-robinson %u
Icon=firefox
Terminal=false
Type=Application
