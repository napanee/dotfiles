esac

function gencert() {
  if [ -z "$1" ]; then
    echo "Bitte einen Namen angeben (z.B. gencert meinprojekt)"
    return 1
  fi

  local NAME="$1"
  local TARGET_DIR="$HOME/mkcert"

  mkcert -key-file "$TARGET_DIR/${NAME}-key.pem" \
         -cert-file "$TARGET_DIR/${NAME}-cert.pem" \
         "${NAME}.home"
}
