function vpn_connect() {
  local VPN_HOST="vpn-robinson.plusline.de"
  local VPN_USER="mschneider"
  local VPN_GROUP="ROBINSON"
  local VPN_PASSWORD=""

  if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS: Use the keyring
    # security add-generic-password -w <password> -a "vpn-robinson.plusline.de" -s "mschneider"
    VPN_PASSWORD=$(/usr/bin/security find-generic-password -w -a "$VPN_HOST" -s "$VPN_USER")
  elif [[ -f /etc/arch-release ]] || [[ "$OSTYPE" == "linux-gnu"* ]]; then
    # Linux: Use pass (password-store)
    # Setup:
    #   1. pass init <gpg-key-id>
    #   2. pass insert vpn/mschneider
    VPN_PASSWORD=$(pass vpn/mschneider | head -n 1 | xargs)
  fi

  if [[ -z "$VPN_PASSWORD" ]]; then
    echo "Fehler: Passwort konnte nicht abgerufen werden."
    return 1
  fi

  echo "$VPN_PASSWORD" | sudo openconnect --user="$VPN_USER" --authgroup="$VPN_GROUP" --background --pid-file=/tmp/openconnect.pid "$VPN_HOST" --passwd-on-stdin
}
alias cup="vpn_connect"
alias cdown='sudo kill -INT $(cat /tmp/openconnect.pid 2>/dev/null)'
alias cstatus='pgrep openconnect > /dev/null && echo "VPN: Connected" || echo "VPN: Disconnected"'

