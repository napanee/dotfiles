{
  // ─── Editor ────────────────────────────────────────────────────────────────────
  "editor.bracketPairColorization.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "'SauceCodePro Nerd Font Mono', 'monospace', monospace",
  "editor.fontLigatures": "'ccmp' off",
  "editor.formatOnSave": true,
  "editor.hover.delay": 800,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.renderWhitespace": "all",
  "editor.rulers": [80, 120],
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,

  // ─── Workbench ─────────────────────────────────────────────────────────────────
  "workbench.activityBar.location": "hidden",
  "workbench.colorCustomizations": {},
  "workbench.editor.closeEmptyGroups": false,
  "workbench.editor.customLabels.patterns": {
    "**/page.*": "${dirname}/page.${extname}",
    "**/index.*": "${dirname}/index.${extname}",
    "**/layout.*": "${dirname}/layout.${extname}",
  },
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.statusBar.visible": true,
  "workbench.tree.indent": 15,

  // ─── Explorer & Search ─────────────────────────────────────────────────────────
  "breadcrumbs.enabled": true,
  "explorer.openEditors.visible": 100,
  "files.exclude": {
    "_DEPRECATED_*": true,
    "**/__generated___": true,
    "**/.git": false,
  },
  "search.exclude": {
    "**/.git": true,
    "**/package-lock.json": true,
  },

  // ─── Window ────────────────────────────────────────────────────────────────────
  "window.openFoldersInNewWindow": "on",
  "window.title": "${appName} - ${activeRepositoryName}:${activeRepositoryBranchName}${separator}${activeEditorMedium}",

  // ─── Terminal ──────────────────────────────────────────────────────────────────
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontFamily": "SauceCodePro Nerd Font",
  "terminal.integrated.fontSize": 10,
  "terminal.integrated.tabs.enabled": true,

  // ─── Git ───────────────────────────────────────────────────────────────────────
  "diffEditor.codeLens": true,
  "git.openRepositoryInParentFolders": "always",
  "gitlens.advanced.messages": {
    "suppressDebugLoggingWarning": true,
  },

  // ─── JavaScript / TypeScript ───────────────────────────────────────────────────
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
  "javascript.implicitProjectConfig.experimentalDecorators": true,
  "javascript.updateImportsOnFileMove.enabled": "never",
  "javascript.validate.enable": false,
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBraces": false,
  "typescript.updateImportsOnFileMove.enabled": "never",

  // ─── ESLint ────────────────────────────────────────────────────────────────────
  "eslint.codeActionsOnSave.rules": null,
  "eslint.debug": true,
  "eslint.format.enable": true,
  "eslint.lintTask.enable": true,
  "eslint.options": {},
  "eslint.validate": [
    "vue",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],

  // ─── Stylelint ─────────────────────────────────────────────────────────────────
  "stylelint.snippet": ["css", "less", "postcss", "scss", "sass"],
  "stylelint.validate": ["css", "less", "postcss", "scss", "sass"],

  // ─── HTML & Emmet ──────────────────────────────────────────────────────────────
  "emmet.syntaxProfiles": { "javascript": "jsx" },
  "emmet.triggerExpansionOnTab": true,
  "html.format.enable": false,
  "html.validate.scripts": false,
  "html.validate.styles": false,

  // ─── Extension: Material Icon Theme ────────────────────────────────────────────
  "material-icon-theme.activeIconPack": "react",
  "material-icon-theme.files.associations": {
    ".moccu": "moccu",
    ".gitconfig*": "git",
    "gitconfig*": "git",
    ".gitconfig-work": "git",
    "gitconfig-work": "git",
  },

  // ─── Extension: Color Highlight ────────────────────────────────────────────────
  "color-highlight.markerType": "dot-before",

  // ─── Extension: SonarLint ──────────────────────────────────────────────────────
  "sonarlint.rules": {
    "typescript:S1854": { "level": "on" },
    "typescript:S6479": { "level": "on" },
    "typescript:S3358": { "level": "on" },
  },

  // ─── Extension: Peacock ────────────────────────────────────────────────────────
  "peacock.favoriteColors": [
    { "name": "Angular Red", "value": "#b52e31" },
    { "name": "Auth0 Orange", "value": "#eb5424" },
    { "name": "Azure Blue", "value": "#007fff" },
    { "name": "C# Purple", "value": "#68217A" },
    { "name": "Gatsby Purple", "value": "#639" },
    { "name": "Go Cyan", "value": "#5dc9e2" },
    { "name": "Java Blue-Gray", "value": "#557c9b" },
    { "name": "JavaScript Yellow", "value": "#f9e64f" },
    { "name": "Mandalorian Blue", "value": "#1857a4" },
    { "name": "Node Green", "value": "#215732" },
    { "name": "React Blue", "value": "#00b3e6" },
    { "name": "Something Different", "value": "#832561" },
    { "name": "Vue Green", "value": "#42b883" },
  ],

  // ─── Telemetry & AI ────────────────────────────────────────────────────────────
  "chat.disableAIFeatures": true,
  "github.copilot.advanced": { "authProvider": "github" },
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "redhat.telemetry.enabled": false,
  "workbench.iconTheme": "material-icon-theme",
}
