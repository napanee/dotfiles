# kanshi configuration
# Multi-Monitor-Layouts per EDID-/Serial-Match statt Output-Name (robust gegen
# MST/Daisy-Chain-Reihenfolge und Namenswechsel nach Resume/Hotplug).
# Siehe MIGRATION.md §0.4 und §6.
#
# WICHTIG: Die hier verwendeten description-Strings sind PLATZHALTER auf Basis
# der bekannten EDID-Seriennummern. Der exakte Match-String muss am lebenden
# System ausgelesen und eingetragen werden:
#     hyprctl monitors        (Feld "description")
#     wlr-randr                (Zeile "Make/Model/Serial")
# kanshi matcht standardmaessig die vollstaendige description-Zeile, z.B.
#     "Dell Inc. DELL U3225QE D02G684".
#
# Portrait-Transform: 270 = "rotate left" aus xrandr. Einmal visuell
# verifizieren; ggf. auf 90 wechseln.

# Dell U3225QE, Serial D02G684  -> Primary 4K, normal
# Dell U2723QE, Serial C55F2H3  -> Portrait 4K, rotate left (transform 270)
# eDP-1                         -> Laptop-Panel 1920x1200

# --- Desktop: beide externen Monitore, kein Laptop-Panel ---
profile desktop {
    # TODO: description am lebenden System auslesen (hyprctl monitors / wlr-randr).
    output "Dell Inc. DELL U3225QE D02G684" mode 3840x2160 position 2160,840 transform normal
    # TODO: description am lebenden System auslesen (hyprctl monitors / wlr-randr).
    output "Dell Inc. DELL U2723QE C55F2H3" mode 3840x2160 position 0,0 transform 270
}

# --- Laptop + beide externen Monitore ---
profile office {
    # TODO: description am lebenden System auslesen (hyprctl monitors / wlr-randr).
    output "Dell Inc. DELL U3225QE D02G684" mode 3840x2160 position 2160,840 transform normal
    # TODO: description am lebenden System auslesen (hyprctl monitors / wlr-randr).
    output "Dell Inc. DELL U2723QE C55F2H3" mode 3840x2160 position 0,0 transform 270
    output eDP-1 mode 1920x1200 position 6000,1920 transform normal
}

# --- Laptop allein ---
profile single {
    output eDP-1 mode 1920x1200 position 0,0 transform normal
}
