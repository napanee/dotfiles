{
	"custom/archicon": {
		"format": "",
		"tooltip": false
	},

	"hyprland/workspaces": {
		// Zeigt pro Monitor nur dessen Workspaces (siehe workspace=...,monitor:...).
		// {icon} = Workspace-Glyph, {windows} = Icons der offenen Fenster.
		"format": "{icon}{windows}",
		"format-window-separator": "",
		"window-rewrite-default": "",
		"window-rewrite": {
			"class<firefox>": " 󰈹",
			"class<signal>": " 󰭹",
			"class<org.wezfurlong.wezterm>": " ",
			"class<kiro>": " 󰇩",
			"class<[Cc]ode>": " 󰨞",
			"class<teams>": " 󰊻",
			"title<.*Microsoft Teams.*>": " 󰊻"
		},
		"on-click": "activate",
		"sort-by-number": true,
		"persistent-workspaces": {
			"*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
		},
		"format-icons": {
			"1": "󰎦",
			"2": "󰎩",
			"3": "󰎬",
			"4": "󰎮",
			"5": "󰎰",
			"6": "󰎵",
			"7": "󰎸",
			"8": "󰎻",
			"9": "󰎾",
			"default": ""
		}
	},

	// Zeigt das aktuelle Tiling-Layout (master/monocle) des aktiven Workspace.
	"custom/layout": {
		"exec": "~/.config/waybar/scripts/layout-status.sh",
		"return-type": "json",
		"interval": 1,
		"tooltip": true
	},

	"hyprland/window": {
		"format": "{title}",
		"icon": true,
		"icon-size": 16,
		"max-length": 80,
		"expand": true,
		"separate-outputs": true
	}
}