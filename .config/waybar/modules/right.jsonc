{
  "tray": {
    "spacing": 4,
    "icon-size": 12
  },

  "cpu": {
    "interval": 10,
    "format": "<span letter_spacing='1024'> </span>{load:.0f}%"
  },

  "memory": {
    "interval": 30,
    "format": "<span letter_spacing='1024'> </span>{used:.0f}G/{total:.0f}G<span letter_spacing='1024'> </span>S:{swapPercentage}%"
  },

  "network": {
    "format": "{ifname}",
    "format-wifi": "<span letter_spacing='1024'> </span>{essid} ({ipaddr})",
    "format-ethernet": "<span letter_spacing='1024'> </span>{ifname}",
    "format-disconnected": ""
  },

  "pulseaudio": {
    // <span> = Pango-Markup: faerbt nur das Icon, Wert bleibt Modulfarbe.
    "format": "{icon}<span letter_spacing='1024'> </span>{volume}%",
    "format-muted": "󰝟<span letter_spacing='1024'> </span>muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "changevolume mute",
    "scroll-step": 5
  },

  "battery": {
    "format": "{icon}<span letter_spacing='1024'> </span>{capacity}%{time}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    },
    "format-time": " ({H}:{m}h)",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "clock": {
		"interval": 1,
		"format": "<span letter_spacing='1024'> </span>{:%a %d. %b<span letter_spacing='1024'> </span><span letter_spacing='1024'> </span>%H:%M:%S}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode": "year",
			"mode-mon-col": 3,
			"weeks-pos": "left",
			"first-day-of-week": 1,
			"iso8601": true,
			"on-scroll": 1,
			"on-click-right": "mode",
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"days": "<span color='#ecc6d9'><b>{}</b></span>",
				"weeks": "<span color='#99ffdd'><b>W{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6699'><b><u>{}</u></b></span>"
			}
		}
	}
}