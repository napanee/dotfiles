{
	"layer": "top",
	"position": "top",
	// "height": 16,
	"spacing": 0,
	"margin": 5,
	"reload_style_on_change": true,

	"modules-left": [
		"custom/archicon",
		"hyprland/workspaces",
		"custom/layout",
		"hyprland/window"
	],
	"modules-center": [],
	"modules-right": [
		"tray",
		"cpu",
		"memory",
		"network",
		"pulseaudio",
		"battery",
		"clock"
	],

	"include": [
		"~/.config/waybar/modules/left.jsonc",
		"~/.config/waybar/modules/right.jsonc"
	]
}
